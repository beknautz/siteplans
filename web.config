<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Serve index.php when hitting the root URL -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Pass PHP errors through instead of generic IIS error page -->
    <httpErrors existingResponse="PassThrough" />

    <!-- No directory listing -->
    <directoryBrowse enabled="false" />

  </system.webServer>
</configuration>
