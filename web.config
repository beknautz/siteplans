<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <system.webServer>

    <!-- ── Default documents ──────────────────────────────── -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- ── Directory browsing OFF ─────────────────────────── -->
    <directoryBrowse enabled="false" />

    <!-- ── URL Rewriting (requires IIS URL Rewrite module) ── -->
    <rewrite>
      <rules>
        <!-- Route bare /admin/site-plans to index.php -->
        <rule name="SitePlans index" stopProcessing="true">
          <match url="^admin/site-plans/?$" />
          <action type="Redirect" url="/admin/site-plans/index.php" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <!-- ── Static file handling ───────────────────────────── -->
    <staticContent>
      <mimeMap fileExtension=".css"  mimeType="text/css" />
      <mimeMap fileExtension=".js"   mimeType="application/javascript" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".svg"  mimeType="image/svg+xml" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <!-- ── Custom error pages ─────────────────────────────── -->
    <httpErrors errorMode="DetailedLocalOnly" />

  </system.webServer>

  <!-- ── PHP settings (adjust path if needed) ────────────── -->
  <system.web>
    <compilation debug="false" />
    <customErrors mode="Off" />
  </system.web>

</configuration>
